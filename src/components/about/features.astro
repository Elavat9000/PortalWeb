---
import ServiceCard from "./ServiceCard.astro";
import { FaLaptopCode, FaBolt, FaRocket } from "react-icons/fa"; 
---

<section class="site-container mt-14 mx-auto max-w-6xl px-4">
	<h2
		class="text-4xl font-bold flex flex-col items-center gap-6 text-center whitespace-nowrap text-white md:flex-row md:items-center md:text-end"
	>
		<span class="hidden h-1.5 grow rounded-lg drop-shadow-[2px_2px_0_#737670] bg-[#770d10] md:block"></span>
		<span class="drop-shadow-[2px_2px_0_#770d10]">Servicios</span>
	</h2>

	<div class="mt-10 grid gap-6 md:grid-cols-3">
		<ServiceCard
			icon={FaLaptopCode}
			title="Análisis de Datos"
			description="Análisis y exploración de datos para identificar patrones, generar insights y apoyar la toma de decisiones, utilizando Python, pandas, NumPy y visualización básica."
		/>
		<ServiceCard
			icon={FaBolt}
			title="Automatización de Procesos"
			description="Automatización de tareas repetitivas y procesos operativos mediante scripts en Python, optimizando tiempos, reduciendo errores y mejorando la eficiencia."
		/>

		<ServiceCard
			icon={FaRocket}
			title="Desarrollo Web"
			description="Desarrollo de sitios y aplicaciones web responsivas y funcionales, con enfoque en el usuario, usando tecnologías modernas como Astro, React y Tailwind CSS."
		/>
	</div>
</section>
